DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=allthings_db

JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

PORT=5000

# Admin credentials (change these!)
ADMIN_EMAIL=admin@allthings.com
ADMIN_PASSWORD=Admin@123

# File upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# Email (Gmail - use App Password, not your real password)
# Go to Google Account → Security → 2-Step Verification → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=allthingsethiopia2026@gmail.com
MAIL_PASS=your_gmail_app_password_here
MAIL_FROM="All Things" <allthingsethiopia2026@gmail.com>
NOTIFY_EMAIL=allthingsethiopia2026@gmail.com

# Africa's Talking SMS (for user activation notifications)
# Sign up at https://africastalking.com
# For testing use username=sandbox and get your sandbox API key from the dashboard
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SENDER_ID=AllThings
